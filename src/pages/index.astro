    <script is:inline>
      const form = document.getElementById("demo-form");
      const status = document.getElementById("form-status");
      const calendarBox = document.getElementById("calendar-box");
      const conoscenza = document.getElementById("conoscenza");
      const bniField = document.getElementById("capitolo-bni-field");
      const altroField = document.getElementById("altro-conoscenza-field");

      function aggiornaCampiCondizionali() {
        const value = conoscenza.value;
        bniField.classList.toggle("is-visible", value === "BNI");
        altroField.classList.toggle("is-visible", value === "Altro");

        const bniInput = bniField.querySelector("input");
        const altroInput = altroField.querySelector("input");

        bniInput.required = value === "BNI";
        altroInput.required = value === "Altro";

        if (value !== "BNI") bniInput.value = "";
        if (value !== "Altro") altroInput.value = "";
      }

      conoscenza.addEventListener("change", aggiornaCampiCondizionali);

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const button = form.querySelector('button[type="submit"]');
        const originalText = button.textContent;

        button.disabled = true;
        button.textContent = "Invio in corso…";
        status.textContent = "";
        status.className = "form-status";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });

          if (!response.ok) throw new Error("Invio non riuscito");

          form.reset();
          aggiornaCampiCondizionali();
          status.textContent =
            "✅ Richiesta inviata correttamente! ➡️ Ora clicca sul pulsante 'Prenota la tua demo' qui a destra.";
          status.classList.add("success");
          calendarBox.hidden = false;
        } catch (error) {
          status.textContent =
            "Non è stato possibile inviare la richiesta. Riprova tra poco.";
          status.classList.add("error");
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      });
    </script>
